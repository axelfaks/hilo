# Copiá este archivo como  .env  y pegá UNA de las dos claves.
# La app usa la que encuentre; si están las dos, manda HILO_PROVEEDOR.

# --- Gemini (tiene capa gratuita, no pide tarjeta) ---
# La sacás de https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Claude ---
# La sacás de https://platform.claude.com/settings/keys (se paga aparte)
ANTHROPIC_API_KEY=

# Opcionales
# HILO_PROVEEDOR=gemini      # gemini | anthropic, si tenés las dos claves
# GEMINI_MODEL=              # vacío = la app le pregunta a Google cuál usar
# ANTHROPIC_MODEL=claude-sonnet-4-5
# HILO_OFFLINE=1             # fuerza el modo sin IA

# --- WhatsApp Cloud API (el segundo canal real) ---
# Meta → tu app → WhatsApp → Configuración de la API
WA_TOKEN=                    # token de acceso. El temporal dura 24 h: para que no se
                             # caiga solo, generá uno permanente con un usuario del
                             # sistema en Meta Business → Usuarios del sistema.
WA_APP_ID=                    # id de la app Hilo en Meta. Hace falta para
                             # que un cliente conecte su WhatsApp (Embedded Signup).
WA_PHONE_ID=                 # "Identificador del número de teléfono". NO es el número.
WA_WABA_ID=                  # identificador de la cuenta de WhatsApp Business (opcional)
WA_NUMERO=                   # tu número, solo para mostrarlo en Configuración
WA_VERIFY_TOKEN=             # una frase inventada por vos; la misma va en el panel de Meta
WA_APP_SECRET=               # Meta → Configuración de la app → Básica → Clave secreta.
                             # Sin esto el webhook le cree a cualquiera que sepa la URL.
# WA_VERSION=v25.0           # versión de la Graph API

# --------------------------------------------------------------- Mercado Pago
# La suscripción con tarjeta del cliente. SIN esto, Hilo anda igual en "modo
# simulado": el checkout es una pantalla nuestra de mentira y no se cobra nada.
#
# El token sale de mercadopago.com.ar/developers/panel -> tu aplicación ->
# Credenciales. Las de PRUEBA empiezan con TEST- y no mueven plata.
#
# OJO con de quién es la cuenta: las suscripciones viven en la cuenta que cobra.
# Si empezás con una cuenta y después migrás a otra, cada cliente tiene que
# volver a poner la tarjeta.
MP_ACCESS_TOKEN=
MP_SIMULADO=              # 1 fuerza el modo simulado aunque haya token

# A dónde vuelve el cliente después de pagar, y a dónde le pega Mercado Pago con
# el webhook. En local no hace falta; en la nube sí, porque el server no sabe
# por qué dominio lo llamaron.
HILO_URL=https://hilo-jx40.onrender.com

# ------------------------------------------------------------------ Telegram
# UN SOLO bot para todos los clientes: el token es nuestro, no de ellos. Se saca
# en dos minutos hablándole a @BotFather en Telegram: /newbot, nombre, usuario.
#
# Sin esto, la pantalla de Canales muestra Telegram como "todavía no".
TG_TOKEN=
TG_SECRETO=                  # una frase inventada por vos. Telegram la devuelve en
                             # cada webhook y así sabemos que el pedido es de él.
                             # Si la dejás vacía se deriva del token.
# TG_API=                    # solo para pruebas: apunta a un Telegram de mentira
